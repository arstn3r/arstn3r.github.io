<?php
$base = "..";
require "../db.php";

$sqlDelete = "DELETE FROM admins WHERE admin_id=?";
$sqlSelect = "SELECT admin_id, username, password_hash FROM admins WHERE admin_id=?";
$error = "";

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        db_query($sqlDelete, [$_POST['admin_id']]);
        header("Location: list.php");
        exit;
    } catch (PDOException $e) {
        $error = "Delete failed: " . $e->getMessage();
    }
}

$id = isset($_POST['admin_id']) ? $_POST['admin_id'] : (isset($_GET['id']) ? $_GET['id'] : '');
$stmt = db_query($sqlSelect, [$id]);
$row = db_fetch($stmt);
if (!$row) { header("Location: list.php"); exit; }

require "../header.php";
?>

<h2>Delete Admin</h2>

<?php if ($error): ?><div class="msg-error"><?= htmlspecialchars($error) ?></div><?php endif; ?>

<p>Are you sure you want to delete this record?</p>

<table>
    <tr><th>admin_id</th><td><?= htmlspecialchars($row['admin_id']) ?></td></tr>
    <tr><th>username</th><td><?= htmlspecialchars($row['username']) ?></td></tr>
    <tr><th>password_hash</th><td><?= htmlspecialchars($row['password_hash']) ?></td></tr>
</table>

<form method="POST">
    <input type="hidden" name="admin_id" value="<?= htmlspecialchars($row['admin_id']) ?>">
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a href="list.php" class="btn btn-secondary">Cancel</a>
</form>

<?php sql_box($sqlDelete, $sqlSelect); ?>

<?php require "../footer.php"; ?>
